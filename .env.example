# Public Convex deployment URL (Settings → URL in the Convex dashboard)
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Public site origin used for canonical URLs, sitemap, Open Graph, and Convex Auth
VITE_SITE_URL=http://localhost:5173
SITE_URL=http://localhost:5173

# Convex Auth (set in the Convex dashboard, never in Vite)
# Generated by: npx @convex-dev/auth
# JWT_PRIVATE_KEY=
# JWKS=
# CONVEX_SITE_URL=https://your-deployment.convex.site

# One-time first-admin bootstrap token (Convex dashboard env var, server-only)
# ADMIN_BOOTSTRAP_TOKEN=

# Optional sample-content seed token (Convex dashboard env var, server-only)
# SEED_SECRET=

# Optional admin quote notifications via Resend (Convex dashboard env var)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Ink & Identity <hello@example.com>
